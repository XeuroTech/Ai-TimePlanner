# Copy to .env and fill in. All values are safe to expose in a client build
# (Firebase web config is not secret), but keep .env out of version control.

EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Drive backup ("Backup & Sync" on the Profile screen).
# One OAuth client PER PLATFORM, created in Google Cloud Console — the Android
# one must be registered against package `com.TimePlanner.company` plus your
# signing SHA-1. Full walkthrough: GOOGLE_DRIVE_BACKUP_SETUP.md
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# The OAuth redirect scheme is derived from the client ID above
# (com.googleusercontent.apps.<id>) and must also be listed in `expo.scheme` in
# app.json — see step 6 of the setup guide. Override it only if you registered a
# different redirect with Google:
# EXPO_PUBLIC_GOOGLE_REDIRECT_SCHEME=com.googleusercontent.apps.xxxx

# Groq API key for the AI Assistant (https://console.groq.com/keys).
EXPO_PUBLIC_GROQ_API_KEY=gsk_your_groq_api_key
